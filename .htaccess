<IfModule mod_rewrite.c>
  RewriteEngine On

  # Zachovat Authorization hlavičku pro PHP API.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # API zpracovává vlastní .htaccess v podadresáři api/.
  RewriteRule ^api(?:/|$) - [L]

  # SPA fallback funguje v kořeni domény i v lokální /Rezervace podsložce.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Cache static assets
  Header set Cache-Control "max-age=31536000" "expr=%{REQUEST_URI} =~ /\.(js|css)$/"
  Header set Cache-Control "max-age=0" "expr=%{REQUEST_URI} =~ /\.html$/"
</IfModule>
