<IfModule mod_rewrite.c>
  RewriteEngine On

  # Zachovat Authorization hlavičku pro PHP API.
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # API zpracovává vlastní .htaccess v podadresáři api/.
  RewriteRule ^api(?:/|$) - [L]

  # SPA fallback funguje v kořeni domény i v lokální /Rezervace podsložce.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Verzované assety mohou zůstat dlouhodobě v cache.
  Header set Cache-Control "max-age=31536000" "expr=%{REQUEST_URI} =~ /\.(js|css)$/"

  # Vstupní SPA dokument se servíruje také pro URL "/", kde REQUEST_URI
  # nekončí na .html. FilesMatch proto zajistí vždy čerstvý odkaz na build.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
