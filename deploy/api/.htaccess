RewriteEngine On

# API router: veřejné endpointy směrují do index.php.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# Implementační a konfigurační soubory nesmí být dostupné přímo přes HTTP.
<FilesMatch "^(config(?:\..+)?|db|auth|mail|slots)\.php$">
    Require all denied
</FilesMatch>

<Files "index.php">
    Require all granted
</Files>
